# Azure AD app registration values. Copy to .env and fill in.
# See README.md for how to create the app registration.

# Application (client) ID from the Azure Portal app registration.
OUTLOOK_CLIENT_ID=

# Tenant ID. Use "common" for personal Outlook.com + work/school accounts,
# "consumers" for personal-only, or your tenant GUID for work-only.
OUTLOOK_TENANT_ID=common

# Where the encrypted MSAL token cache is stored on disk.
OUTLOOK_TOKEN_CACHE=.token_cache.bin
